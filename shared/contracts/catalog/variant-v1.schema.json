{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indigententerprises:catalog:variant:1",
  "title": "VariantV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["variantId", "sku", "price", "optionValues"],
  "properties": {
    "variantId": { "$ref": "urn:indigententerprises:common:identifiers:1#/$defs/uuid" },
    "sku": { "type": "string", "minLength": 1, "maxLength": 80 },
    "price": { "$ref": "urn:indigententerprises:common:money:1" },
    "compareAtPrice": { "$ref": "urn:indigententerprises:common:money:1" },
    "optionValues": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "maxLength": 60 }
    }
  }
}

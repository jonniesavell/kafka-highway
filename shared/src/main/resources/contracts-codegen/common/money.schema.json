{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "classpath:/contracts-codegen/common/money.schema.json",
  "title" : "Money",
  "type" : "object",
  "additionalProperties" : false,
  "required" : [ "currency", "amount" ],
  "properties" : {
    "currency" : {
      "type" : "string",
      "pattern" : "^[A-Z]{3}$"
    },
    "amount" : {
      "type" : "string",
      "pattern" : "^[0-9]+(\\.[0-9]{1,4})?$"
    }
  },
  "x-canonical-urn" : "urn:indigententerprises:common:money:1"
}